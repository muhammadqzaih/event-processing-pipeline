{
  "name": "webhook-pipeline",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "worker": "node dist/workerStarter.js",
    "worker:dev": "tsx watch src/workerStarter.ts",
    "prisma:generate": "prisma generate --schema=src/infrastructure/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=src/infrastructure/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=src/infrastructure/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=src/infrastructure/prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema=src/infrastructure/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=src/infrastructure/prisma/schema.prisma"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhammadqzaih/event-processing-pipeline.git"
  },
